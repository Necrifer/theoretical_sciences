    },
    {
      "id": "quench",
      "kind": "quench",
      "expr": "Bc - (Bsh)",
      "formula": "B < B_c(T)"
    }
  ],
  "rate": "clamp(snr/3, 0, 4)",
  "rate_formula": "rate = significance / 3\u03c3",
  "heat": "3 + 0.2*Md",
