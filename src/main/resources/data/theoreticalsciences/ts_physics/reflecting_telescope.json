{
  "params": [
    {
      "id": "D",
      "unit": "m",
      "min": 0.1,
      "max": 2.4,
      "step": 0.01,
      "default": 1.0
    },
    {
      "id": "t",
      "unit": "s",
      "min": 0.001,
      "max": 3600,
      "step": 0.001,
      "default": 60
    }
  ],
  "recipe_vars": {
    "mreq": 9,
    "mstar": 0.0,
    "dep": 0.0
  },
  "consts": [],
  "states": [],
  "derived": [
    {
      "id": "see",
      "unit": "″",
      "expr": "2.5*exp(-pos(alt - 64)/120)*(1 + 0.15*d)",
      "formula": "θ_see ≈ 2.5″·e^(−(h − 64)/120)"
    },
    {
      "id": "th",
      "unit": "″",
      "expr": "0.1384/D",
      "formula": "θ = 1.22λ/D"
    },
    {
      "id": "fr",
      "unit": "",
      "expr": "0.3 + 0.7*t/(t + 0.05)",
      "formula": "lucky imaging",
      "show": false
    },
    {
      "id": "res",
      "unit": "″",
      "expr": "sqrt(th^2 + (see*fr)^2)",
      "formula": "θ = √(θ_diff² + θ_see²)"
    },
    {
      "id": "msky",
      "unit": "mag/□″",
      "expr": "21.6 - 3.2*moon - 8*(1 - night)",
      "formula": "μ_sky"
    },
    {
      "id": "mlim",
      "unit": "mag",
      "expr": "13.2 + 5*log10(D) + 1.25*log10(t) + 0.5*(msky - 21.6) - 2.5*log10(max(res, 0.05))",
      "formula": "m_lim ≈ m₀ + 5 log D + 1.25 log t + ½(μ − μ₀) − 2.5 log θ"
    },
    {
      "id": "snrT",
      "unit": "",
      "expr": "dep*sqrt(1e10*D^2*t*10^(-0.4*mstar))/1e6",
      "formula": "transit spectroscopy: the feature's depth (ppm) over the photon noise 1/√N"
    }
  ],
  "constraints": [
    {
      "id": "dark",
      "kind": "stop",
      "expr": "night - 0.9",
      "formula": "night"
    },
    {
      "id": "sky",
      "kind": "stop",
      "expr": "sky - 0.5",
      "formula": "open sky"
    },
    {
      "id": "clouds",
      "kind": "stop",
      "expr": "0.5 - rain",
      "formula": "no rain"
    }
  ],
  "rate": "clamp((1 + 0.3*(mlim - mreq))/(1 + t/1200), 0.2, 2)",
  "rate_formula": "rate = (1 + 0.3·(m_lim − m_need)) / (1 + t/1200 s)",
  "heat": "0.02",
  "idle_heat": "0",
  "quench_energy": "0",
  "kappa": 40,
  "heat_capacity": 40,
  "timescale": 1,
  "rate_max": 4
}