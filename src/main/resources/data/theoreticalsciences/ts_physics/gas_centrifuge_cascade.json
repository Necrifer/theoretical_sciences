      "formula": "R_F = x_F/(1 \u2212 x_F)",
      "show": false
    },
    {
      "id": "xP",
      "unit": "",
      "expr": "Rf*be^n/(1 + Rf*be^n)",
      "formula": "x_P = R_F \u03b2\u207f/(1 + R_F \u03b2\u207f)"
    },
    {
      "id": "sig",
      "unit": "MPa",
      "expr": "0.0016*ve^2",
