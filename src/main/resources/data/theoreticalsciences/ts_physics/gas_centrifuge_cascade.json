      "formula": "\u03b1 = e^(\u0394m v\u00b2/2RT)"
    },
    {
      "id": "be",
      "unit": "",
      "expr": "1 + (al - 1)*(1 - th)",
      "formula": "\u03b2 = 1 + (\u03b1 \u2212 1)(1 \u2212 \u03b8)"
    },
    {
      "id": "n",
      "unit": "",
      "expr": "size",
