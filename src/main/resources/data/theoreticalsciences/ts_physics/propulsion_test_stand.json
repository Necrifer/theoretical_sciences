    {
      "id": "eta",
      "unit": "",
      "expr": "1 - eps^(-1.7*(g - 1)/g)",
      "formula": "nozzle efficiency: the share of the heat the expansion turns into speed"
    },
    {
      "id": "ve",
      "unit": "m/s",
      "expr": "(1 - ion)*sqrt(2*g/(g - 1)*8.314*Tc/(M/1000)*(1 - eps^(-1.7*(g - 1)/g)))*(1 - 0.01*d) + ion*0.75*sqrt(2*1.602e-19*Vg*1000/(M*1.6605e-27))*(1 - 0.01*d)",
      "formula": "thermal: ve = √(2γ/(γ−1)·RT/M·η); ion: ve = √(2qV/m)"
    },
    {
      "id": "Isp",
      "unit": "s",
      "expr": "((1 - ion)*sqrt(2*g/(g - 1)*8.314*Tc/(M/1000)*(1 - eps^(-1.7*(g - 1)/g))) + ion*0.75*sqrt(2*1.602e-19*Vg*1000/(M*1.6605e-27)))*(1 - 0.01*d)/9.80665",
      "formula": "Isp = ve/g₀"
    },
    {
      "id": "dv",
      "unit": "km/s",
      "expr": "((1 - ion)*sqrt(2*g/(g - 1)*8.314*Tc/(M/1000)*(1 - eps^(-1.7*(g - 1)/g))) + ion*0.75*sqrt(2*1.602e-19*Vg*1000/(M*1.6605e-27)))*(1 - 0.01*d)*ln(1/(1 - zeta))/1000",
      "formula": "Δv = ve·ln(m₀/m_f), with m₀/m_f = 1/(1 − ζ)"
    }
  ],
  "constraints": [
