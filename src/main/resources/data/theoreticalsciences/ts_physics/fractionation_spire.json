      "show": false
    },
    {
      "id": "Nmin",
      "unit": "",
      "expr": "ln((xD/(1-xD))*((1-0.05)/0.05))/ln(al)",
      "formula": "N_min = ln[(x_D/(1\u2212x_D))((1\u2212x_B)/x_B)] / ln \u03b1"
    },
    {
      "id": "Rmin",
      "unit": "",
      "expr": "(xD/xFe - al*(1-xD)/(1-xFe))/(al - 1)",
      "formula": "R_min = (x_D/x_F \u2212 \u03b1(1\u2212x_D)/(1\u2212x_F))/(\u03b1 \u2212 1)"
    },
    {
