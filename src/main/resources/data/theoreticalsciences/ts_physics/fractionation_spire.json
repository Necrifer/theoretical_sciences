    },
    {
      "id": "Nreq",
      "unit": "",
      "expr": "(Nmin + 0.75*(1 - Xg^0.5668))/(1 - 0.75*(1 - Xg^0.5668))",
      "formula": "Y = 0.75(1 \u2212 X^0.5668),  N = (N_min + Y)/(1 \u2212 Y)"
    },
    {
      "id": "Dr",
      "unit": "mol/s",
      "expr": "Qr/((Rr + 1)*dH)",
