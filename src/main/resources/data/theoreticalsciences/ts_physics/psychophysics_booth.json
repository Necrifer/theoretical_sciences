{
  "params": [
    {
      "id": "Lg",
      "unit": "log",
      "min": -2,
      "max": 3,
      "step": 0.05,
      "default": 0
    },
    {
      "id": "cc",
      "unit": "σ",
      "min": 0,
      "max": 4,
      "step": 0.05,
      "default": 1
    },
    {
      "id": "n",
      "unit": "trials",
      "min": 10,
      "max": 1000,
      "step": 10,
      "default": 100
    }
  ],
  "recipe_vars": {},
  "consts": [],
  "states": [],
  "derived": [
    {
      "id": "dp",
      "unit": "",
      "expr": "0.5*ln(10^Lg/0.01)*(1 - 0.02*d)",
      "formula": "d′ = k·ln(I/I₀): the Weber–Fechner sensation"
    },
    {
      "id": "H",
      "unit": "",
      "expr": "0.5*(1 + tanh(0.8*(dp - cc)))",
      "formula": "hits: the share of signals seen"
    },
    {
      "id": "F",
      "unit": "",
      "expr": "0.5*(1 + tanh(-0.8*cc))",
      "formula": "false alarms: noise taken for a signal"
    },
    {
      "id": "se",
      "unit": "",
      "expr": "sqrt(H*(1 - H)/n)",
      "formula": "the uncertainty on the hit rate"
    }
  ],
  "constraints": [
    {
      "id": "glare",
      "kind": "wear",
      "expr": "2.5 - Lg",
      "formula": "I below 10^2.5: brighter bleaches the retina"
    },
    {
      "id": "blind",
      "kind": "stop",
      "expr": "dp",
      "formula": "the signal must be above threshold at all"
    }
  ],
  "rate": "clamp(200/n, 0.2, 1.5)",
  "rate_formula": "more trials, slower runs",
  "heat": "0",
  "idle_heat": "0",
  "quench_energy": "0",
  "kappa": 40,
  "heat_capacity": 60,
  "timescale": 1,
  "rate_max": 1.5
}